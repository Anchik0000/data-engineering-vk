# Конфигурация HDFS для стенда.
# Сам Hadoop настраивается не переменными окружения, 
# а XML-файлами в папке /opt/hadoop/etc/hadoop 
# внутри контейнера: core-site.xml для общих настроек, hdfs-site.xml для HDFS, 
# yarn-site.xml для YARN и так далее.

# Писать и монтировать в контейнеры XML-файлы неудобно, 
# поэтому авторы образа положили в него маленький скрипт envtoconf.py, 
# который запускается при старте контейнера перед самим Hadoop. 
# Он просматривает переменные окружения и каждую с именем по шаблону с именем файла заглавными буквами
# а потом идёт нижнее подчеркивание и уже ключ для hadoop

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.tmp.dir=/data/tmp

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=/data/namenode
HDFS-SITE.XML_dfs.datanode.data.dir=/data/datanode

HDFS-SITE.XML_dfs.replication=3
HDFS-SITE.XML_dfs.blocksize=134217728

# Обнаружение отказа ускорено: heartbeat как в продакшене (3 с), recheck 15 с вместо 5 минут.
# Узел считается мёртвым через 2*recheck + 10*heartbeat = 60 секунд вместо 10,5 минут.
# heartbeat - периодический сигнал, 
# который рабочие узлы (например, DataNode в HDFS) отправляют управляющему узлу (NameNode), 
# чтобы подтвердить свою работоспособность
HDFS-SITE.XML_dfs.heartbeat.interval=3
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=15000

# Восстановление реплик. Умолчания (2 и 2) рассчитаны на тысячи узлов и планируют по 2 блока на живой
# узел за итерацию в 3 с: 7 500 мелких блоков умершего узла восстанавливались бы полчаса. На стенде из
# четырёх узлов поднимем лимиты, чтобы темп не зависел от планировщика.
HDFS-SITE.XML_dfs.namenode.replication.work.multiplier.per.iteration=32
HDFS-SITE.XML_dfs.namenode.replication.max-streams=16
HDFS-SITE.XML_dfs.namenode.replication.max-streams-hard-limit=32

# Учебный кластер: без прав доступа и без резерва диска.
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.datanode.du.reserved=0
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false

# Доступ к S3-совместимому хранилищу той же командой hdfs dfs (схема s3a://).
CORE-SITE.XML_fs.s3a.endpoint=http://rustfs1:9000
CORE-SITE.XML_fs.s3a.path.style.access=true
CORE-SITE.XML_fs.s3a.connection.ssl.enabled=false
CORE-SITE.XML_fs.s3a.access.key=hhadmin
CORE-SITE.XML_fs.s3a.secret.key=hhadmin-secret
CORE-SITE.XML_fs.s3a.endpoint.region=us-east-1
